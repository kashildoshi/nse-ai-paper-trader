{
  "mcpServers": {
    "upstox": {
      "command": "npx",
      "args": ["-y", "@upstox/mcp-server"],
      "env": {
        "UPSTOX_ACCESS_TOKEN": "YOUR_UPSTOX_ACCESS_TOKEN_HERE_NEVER_IN_CHAT"
      }
    },
    "angelone": {
      "command": "python",
      "args": ["-m", "angelone_mcp"],
      "env": {
        "ANGEL_ONE_API_KEY": "YOUR_SMARTAPI_KEY_HERE_NEVER_IN_CHAT",
        "ANGEL_ONE_CLIENT_CODE": "YOUR_CLIENT_CODE",
        "ANGEL_ONE_PASSWORD": "YOUR_PIN",
        "ANGEL_ONE_TOTP_SECRET": "YOUR_TOTP_SECRET",
        "DRY_RUN_MODE": "true",
        "MAX_ORDER_QUANTITY": "1000"
      }
    }
  }
}
